# ---- Core ----
NODE_ENV=development
PORT=10000
HOST=0.0.0.0
FRONTEND_URL=https://o-clone-test.vercel.app

# ---- Data stores ----
REDIS_URL=
MONGODB_URI=
# ---- WebRTC ICE / TURN ----
# Extra STUN servers (comma-separated); Google STUN is always included.
STUN_URLS=
# Comma-separated provider-supported TURN URIs. Add transports only when enabled by your provider.
# Example: TURN_URLS=turn:turn.example.com:3478
TURN_URLS=
# TURN credentials issued by your provider; required when TURN_URLS is set.
TURN_USERNAME=
TURN_PASSWORD=
# For Coturn REST-style temporary credentials, set true and provide the shared auth secret.
TURN_USE_CONFIG=false
TURN_STATIC_SECRET=
TURN_INSTANCE=drift

# ---- Safety / moderation ----
HASH_SALT=replace-with-long-random-value
ADMIN_API_KEY=

# ---- Tuning ----
MATCH_FIND_COOLDOWN_MS=1500
SESSION_TTL_MS=600000
QUEUE_MAX_AGE_MS=120000
MAX_MESSAGE_LENGTH=500
CHATS_PER_2S=6
PREFS_PATIENCE_MS=25000
